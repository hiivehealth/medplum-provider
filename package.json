{
  "name": "medplum-provider",
  "version": "5.1.39",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "deploy:hiive-build": "bash ./scripts/deploy-hiive-build.sh",
    "lint": "eslint .",
    "lint:ci": "eslint src --ignore-pattern '**/*.test.ts' --ignore-pattern '**/*.test.tsx'",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cui:service": "node server/cui/service.mjs",
    "cui:test-service": "node --test server/cui/__tests__/*.test.mjs",
    "cui:test-live": "node server/cui/__tests__/integration/verify-policy.mjs"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@mantine/spotlight": "8.3.18",
    "@medplum/core": "5.2.16",
    "@medplum/dosespot-react": "5.2.16",
    "@medplum/eslint-config": "5.2.16",
    "@medplum/fhirtypes": "5.2.16",
    "@medplum/health-gorilla-core": "5.2.16",
    "@medplum/health-gorilla-react": "5.2.16",
    "@medplum/mock": "5.2.16",
    "@medplum/react": "5.2.16",
    "@medplum/react-scheduling": "5.2.16",
    "@medplum/scriptsure-react": "5.2.16",
    "@tabler/icons-react": "3.51.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "29.1.1",
    "jsqr": "1.4.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-live": "4.1.8",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "dependencies": {
    "@medplum/core": "5.2.16",
    "@medplum/definitions": "5.2.16"
  }
}
