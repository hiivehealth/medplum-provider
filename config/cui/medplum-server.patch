@@ -0,0 +1,24 @@
+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import { forbidden, OperationOutcomeError } from '@medplum/core';
+import type { Project } from '@medplum/fhirtypes';
+import type { Request, Response } from 'express';
+import { getAuthenticatedContext } from '../context';
+import { getCuiBannerEnabled } from '../fhir/cui-policy';
+
+// Public-to-members display decision, not access to the protected Project configuration.
+export async function cuiBannerHandler(_req: Request, res: Response): Promise<void> {
+  const { repo, systemRepo } = getAuthenticatedContext();
+  // Use the effective repository project (including delegated membership), never a caller-supplied id.
+  const projectId = repo.currentProject()?.id;
+  if (!projectId) {
+    throw new OperationOutcomeError(forbidden);
+  }
+  const project = await systemRepo.readResource<Project>('Project', projectId);
+  res.setHeader('Cache-Control', 'no-store');
+  res.json({
+    projectId,
+    enabled: getCuiBannerEnabled(project),
+    canManage: repo.canManageCuiBanner(projectId) && !!repo.canPerformInteraction('update', project),
+  });
+}
