@@ -0,0 +1,275 @@
+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import type { WithId } from '@medplum/core';
+import { createReference } from '@medplum/core';
+import type { AccessPolicy, Project, ProjectMembership } from '@medplum/fhirtypes';
+import express from 'express';
+import type { Response as TestResponse } from 'supertest';
+import request from 'supertest';
+import { initApp, shutdownApp } from '../app';
+import { loadTestConfig } from '../config/loader';
+import { CUI_ADMIN_URL, CUI_ENABLED_URL } from '../fhir/cui-policy';
+import type { SystemRepository } from '../fhir/repo';
+import { getProjectSystemRepo } from '../fhir/repo';
+import { createTestProject, withTestContext } from '../test.setup';
+
+const app = express();
+
+async function fixture(
+  securityAdmin = false
+): Promise<{
+  project: WithId<Project>;
+  membership: WithId<ProjectMembership>;
+  accessPolicy: WithId<AccessPolicy>;
+  accessToken: string;
+  systemRepo: SystemRepository;
+}> {
+  return withTestContext(async () => {
+    const actor = await createTestProject({
+      withAccessToken: true,
+      withClient: true,
+      membership: { admin: true },
+      accessPolicy: {
+        resource: [{ resourceType: '*' }],
+        extension: securityAdmin ? [{ url: CUI_ADMIN_URL, valueBoolean: true }] : undefined,
+      },
+    });
+    const systemRepo = await getProjectSystemRepo(actor.project);
+    return { ...actor, systemRepo };
+  });
+}
+
+beforeAll(async () => {
+  await initApp(app, await loadTestConfig());
+});
+afterAll(async () => {
+  await shutdownApp();
+});
+
+async function status(token: string): Promise<TestResponse> {
+  return request(app).get('/auth/cui-banner').set('Authorization', `Bearer ${token}`);
+}
+
+async function readProject(token: string, id: string): Promise<TestResponse> {
+  return request(app).get(`/fhir/R4/Project/${id}`).set('Authorization', `Bearer ${token}`);
+}
+
+async function writeProject(token: string, project: Project): Promise<TestResponse> {
+  return request(app).put(`/fhir/R4/Project/${project.id}`).set('Authorization', `Bearer ${token}`).send(project);
+}
+
+test('unauthenticated requests cannot resolve configuration', async () => {
+  expect((await request(app).get('/auth/cui-banner')).status).toBe(401);
+});
+
+test('missing configuration defaults to false for all application consumers', async () => {
+  const actor = await fixture();
+  for (const application of ['provider', 'patient', 'admin']) {
+    const result = await request(app)
+      .get(`/auth/cui-banner?application=${application}`)
+      .set('Authorization', `Bearer ${actor.accessToken}`);
+    expect(result.status).toBe(200);
+    expect(result.body).toEqual({ projectId: actor.project.id, enabled: false, canManage: false });
+    expect(result.headers['cache-control']).toBe('no-store');
+  }
+});
+
+test('security administrator toggles on and off; other projects remain disabled', async () => {
+  const actor = await fixture(true);
+  const other = await fixture();
+  for (const enabled of [true, false]) {
+    const project = (await readProject(actor.accessToken, actor.project.id)).body as Project;
+    project.extension = [{ url: CUI_ENABLED_URL, valueBoolean: enabled }];
+    expect((await writeProject(actor.accessToken, project)).status).toBe(200);
+    expect((await status(actor.accessToken)).body).toEqual({ projectId: actor.project.id, enabled, canManage: true });
+    const read = await readProject(actor.accessToken, actor.project.id);
+    expect(read.body.extension).toContainEqual({ url: CUI_ENABLED_URL, valueBoolean: enabled });
+    expect((await status(other.accessToken)).body.enabled).toBe(false);
+    expect((await readProject(other.accessToken, actor.project.id)).status).not.toBe(200);
+  }
+});
+
+test('ordinary admin cannot read or write extension; unrelated edits preserve it', async () => {
+  const actor = await fixture();
+  await withTestContext(() =>
+    actor.systemRepo.updateResource<Project>({
+      ...actor.project,
+      extension: [{ url: CUI_ENABLED_URL, valueBoolean: true }],
+    })
+  );
+  const read = await readProject(actor.accessToken, actor.project.id);
+  expect(read.status).toBe(200);
+  expect(read.body.extension ?? []).toEqual([]);
+  const forged = { ...read.body, extension: [{ url: CUI_ENABLED_URL, valueBoolean: false }] };
+  expect((await writeProject(actor.accessToken, forged)).status).toBe(403);
+  expect((await writeProject(actor.accessToken, { ...read.body, name: 'Updated project name' })).status).toBe(200);
+  expect((await status(actor.accessToken)).body).toEqual({
+    projectId: actor.project.id,
+    enabled: true,
+    canManage: false,
+  });
+  const history = await request(app)
+    .get(`/fhir/R4/Project/${actor.project.id}/_history`)
+    .set('Authorization', `Bearer ${actor.accessToken}`);
+  expect(history.status).toBe(200);
+  for (const entry of history.body.entry ?? []) {
+    expect(entry.resource?.extension?.some((e: { url: string }) => e.url === CUI_ENABLED_URL)).not.toBe(true);
+  }
+  const patch = await request(app)
+    .patch(`/fhir/R4/Project/${actor.project.id}`)
+    .set('Authorization', `Bearer ${actor.accessToken}`)
+    .set('Content-Type', 'application/json-patch+json')
+    .send([{ op: 'add', path: '/extension', value: forged.extension }]);
+  expect(patch.status).toBe(403);
+});
+
+test('ordinary member cannot directly read or update Project but receives display decision', async () => {
+  const actor = await fixture();
+  await withTestContext(async () => {
+    await actor.systemRepo.updateResource<Project>({
+      ...actor.project,
+      extension: [{ url: CUI_ENABLED_URL, valueBoolean: true }],
+    });
+    await actor.systemRepo.updateResource<ProjectMembership>({ ...actor.membership, admin: false });
+  });
+  expect((await readProject(actor.accessToken, actor.project.id)).status).not.toBe(200);
+  expect(
+    (
+      await writeProject(actor.accessToken, {
+        ...actor.project,
+        extension: [{ url: CUI_ENABLED_URL, valueBoolean: false }],
+      })
+    ).status
+  ).not.toBe(200);
+  expect((await status(actor.accessToken)).body).toEqual({
+    projectId: actor.project.id,
+    enabled: true,
+    canManage: false,
+  });
+});
+
+test('role cannot be forged, edited, assigned, or deleted by ordinary project admins', async () => {
+  const actor = await fixture();
+  const role = await withTestContext(() =>
+    actor.systemRepo.createResource<AccessPolicy>({
+      resourceType: 'AccessPolicy',
+      meta: { project: actor.project.id },
+      extension: [{ url: CUI_ADMIN_URL, valueBoolean: true }],
+      resource: [],
+    })
+  );
+  const auth = `Bearer ${actor.accessToken}`;
+  expect(
+    (
+      await request(app)
+        .post('/fhir/R4/AccessPolicy')
+        .set('Authorization', auth)
+        .send({ resourceType: 'AccessPolicy', extension: role.extension })
+    ).status
+  ).toBe(403);
+  expect(
+    (
+      await request(app)
+        .put(`/fhir/R4/AccessPolicy/${actor.accessPolicy.id}`)
+        .set('Authorization', auth)
+        .send({ ...actor.accessPolicy, extension: role.extension })
+    ).status
+  ).toBe(403);
+  expect([403, 404]).toContain(
+    (await request(app).delete(`/fhir/R4/AccessPolicy/${role.id}`).set('Authorization', auth)).status
+  );
+  expect(await withTestContext(() => actor.systemRepo.readResource('AccessPolicy', role.id))).toBeDefined();
+  const membership = { ...actor.membership, access: [{ policy: createReference(role) }] };
+  expect(
+    (
+      await request(app)
+        .put(`/fhir/R4/ProjectMembership/${actor.membership.id}`)
+        .set('Authorization', auth)
+        .send(membership)
+    ).status
+  ).toBe(403);
+  expect((await status(actor.accessToken)).body.canManage).toBe(false);
+});
+
+test('reject malformed booleans and duplicate explicit settings', async () => {
+  const actor = await fixture(true);
+  for (const extension of [
+    [{ url: CUI_ENABLED_URL, valueString: 'false' }],
+    [
+      { url: CUI_ENABLED_URL, valueBoolean: true },
+      { url: CUI_ENABLED_URL, valueBoolean: false },
+    ],
+  ]) {
+    expect((await writeProject(actor.accessToken, { ...actor.project, extension })).status).toBe(400);
+  }
+});
+
+test('platform operator can configure a project without a security-admin role', async () => {
+  const operator = await withTestContext(() => createTestProject({ superAdmin: true, withAccessToken: true }));
+  const actor = await fixture();
+  expect(
+    (
+      await writeProject(operator.accessToken, {
+        ...actor.project,
+        extension: [{ url: CUI_ENABLED_URL, valueBoolean: true }],
+      })
+    ).status
+  ).toBe(200);
+  expect((await status(actor.accessToken)).body.enabled).toBe(true);
+});
+
+test('transaction and batch writes cannot bypass the protected extension', async () => {
+  const actor = await fixture();
+  for (const type of ['batch', 'transaction']) {
+    const response = await request(app)
+      .post('/fhir/R4')
+      .set('Authorization', `Bearer ${actor.accessToken}`)
+      .send({
+        resourceType: 'Bundle',
+        type,
+        entry: [
+          {
+            request: { method: 'PUT', url: `Project/${actor.project.id}` },
+            resource: { ...actor.project, extension: [{ url: CUI_ENABLED_URL, valueBoolean: true }] },
+          },
+        ],
+      });
+    if (type === 'batch') {
+      expect(response.body.entry[0].response.status).toMatch(/^403/);
+    } else {
+      expect(response.body.entry?.[0]?.response?.status ?? response.status.toString()).toMatch(/^403/);
+    }
+    expect((await status(actor.accessToken)).body.enabled).toBe(false);
+  }
+});
+
+test('stale conditional update does not overwrite another administrator change', async () => {
+  const actor = await fixture(true);
+  const stale = (await readProject(actor.accessToken, actor.project.id)).body;
+  expect(
+    (await writeProject(actor.accessToken, { ...stale, extension: [{ url: CUI_ENABLED_URL, valueBoolean: true }] }))
+      .status
+  ).toBe(200);
+  const conflict = await request(app)
+    .put(`/fhir/R4/Project/${actor.project.id}`)
+    .set('Authorization', `Bearer ${actor.accessToken}`)
+    .set('If-Match', `W/"${stale.meta.versionId}"`)
+    .send({ ...stale, extension: [{ url: CUI_ENABLED_URL, valueBoolean: false }] });
+  expect(conflict.status).toBe(412);
+  expect((await status(actor.accessToken)).body.enabled).toBe(true);
+});
+
+test('operator revocation takes effect for an existing authenticated session', async () => {
+  const actor = await fixture(true);
+  expect((await status(actor.accessToken)).body.canManage).toBe(true);
+  await withTestContext(() => actor.systemRepo.updateResource<AccessPolicy>({ ...actor.accessPolicy, extension: [] }));
+  expect((await status(actor.accessToken)).body.canManage).toBe(false);
+  expect(
+    (
+      await writeProject(actor.accessToken, {
+        ...actor.project,
+        extension: [{ url: CUI_ENABLED_URL, valueBoolean: true }],
+      })
+    ).status
+  ).toBe(403);
+});
