@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: Copyright Orangebot, Inc. and Medplum contributors
+// SPDX-License-Identifier: Apache-2.0
+import { badRequest, OperationOutcomeError, resolveId } from '@medplum/core';
+import type { AccessPolicy, Extension, Project, ProjectMembership } from '@medplum/fhirtypes';
+import type { SystemRepository } from './repo';
+
+export const CUI_ENABLED_URL = 'https://medplum.com/fhir/StructureDefinition/cui-banner-enabled';
+export const CUI_ADMIN_URL = 'https://medplum.com/fhir/StructureDefinition/cui-banner-security-administrator';
+
+export function cuiExtensions(project: Project): Extension[] {
+  if (project.extension !== undefined && !Array.isArray(project.extension)) {
+    throw new OperationOutcomeError(badRequest('Invalid cuiBanner.enabled policy'));
+  }
+  return project.extension?.filter((e) => e.url === CUI_ENABLED_URL) ?? [];
+}
+
+// Missing policy is disabled. Invalid explicit policy is an error, never silently disabled.
+export function getCuiBannerEnabled(project: Project): boolean {
+  const extensions = cuiExtensions(project);
+  if (extensions.length === 0) {
+    return false;
+  }
+  const extension = extensions[0];
+  if (
+    extensions.length !== 1 ||
+    typeof extension.valueBoolean !== 'boolean' ||
+    Object.keys(extension).some((key) => key !== 'url' && key !== 'valueBoolean' && key !== 'id')
+  ) {
+    throw new OperationOutcomeError(badRequest('Invalid cuiBanner.enabled policy'));
+  }
+  return extension.valueBoolean;
+}
+
+// Protected capability marker on a server-managed AccessPolicy, not on a user profile.
+export function hasCuiRoleMarker(policy: AccessPolicy): boolean {
+  return policy.extension?.some((e) => e.url === CUI_ADMIN_URL) ?? false;
+}
+
+export async function hasCuiSecurityRole(repo: SystemRepository, membership: ProjectMembership): Promise<boolean> {
+  const refs = [membership.accessPolicy, ...(membership.access?.map((a) => a.policy) ?? [])];
+  for (const ref of refs) {
+    if (!ref) {
+      continue;
+    }
+    // Read the original policy, before parameter substitution. Roles cannot be supplied as parameters.
+    const policy = await repo.readReference<AccessPolicy>(ref);
+    if (
+      policy.meta?.project === resolveId(membership.project) &&
+      policy.extension?.some((e) => e.url === CUI_ADMIN_URL && e.valueBoolean === true)
+    ) {
+      return true;
+    }
+  }
+  return false;
+}
